{
  "schema_version": "1.3",
  "project": "fit-notes",
  "entrypoint": {
    "agent": "engineering-orchestrator",
    "required_for_production_changes": true
  },
  "paths": {
    "production": ["lib/**", "android/**", "ios/**", "pubspec.yaml", "pubspec.lock", ".github/**"],
    "tests": ["test/**", "integration_test/**"],
    "assurance": [".engineering-assurance/**"],
    "other": ["README.md", "AGENTS.md", "docs/**", ".gitignore", ".metadata", "analysis_options.yaml"]
  },
  "quality_contract": {
    "required_for_behavioral_changes": true,
    "locations": ["docs/quality-contracts/*.md"]
  },
  "review_triggers": {
    "dependencies": ["pubspec.yaml", "pubspec.lock", "**/*.gradle", "**/*.gradle.kts", "ios/Podfile", "ios/Podfile.lock", ".github/workflows/**"]
  },
  "checks": {
    "test": "flutter test",
    "build": "flutter build ios --simulator --debug",
    "analyze": "flutter analyze",
    "architecture": "flutter test test/architecture",
    "dependency_validation": "flutter pub deps",
    "performance": null,
    "runtime_validation": null,
    "reliability": null
  },
  "capabilities": {
    "multi_agent": true,
    "workspace_write": true,
    "git": true,
    "tests": true,
    "device_simulator": false,
    "qa_tooling": false,
    "mutation_tooling": false,
    "performance_tooling": false,
    "runtime_validation": false,
    "observability_access": false
  }
}
